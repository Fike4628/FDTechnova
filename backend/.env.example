# ── Server ─────────────────────────────────────────────
NODE_ENV=development
PORT=8000
CLIENT_URL=http://localhost:5173

# ── Database (PostgreSQL) ──────────────────────────────
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fdteknova_academy
DB_USER=postgres
DB_PASSWORD=postgres
DB_LOGGING=false

# ── Authentication ─────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# ── Email (SMTP) ───────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM="FDTeknova Academy <noreply@example.com>"

# ── File uploads ──────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# ── Payments ───────────────────────────────────────────
PAYMENT_PROVIDER=mock
PAYMENT_SECRET=replace-with-payment-secret
