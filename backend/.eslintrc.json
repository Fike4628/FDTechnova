{
  "root": true,
  "env": {
    "node": true,
    "commonjs": true,
    "es2021": true,
    "jest": true
  },
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "script"
  },
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^(_req|_res|next)$" }],
    "no-console": "off",
    "semi": ["error", "never"],
    "quotes": ["warn", "single"]
  },
  "extends": ["eslint:recommended"]
}
